# =========================================================
# THREE.JS / 3D SETTINGS
# =========================================================

NEXT_PUBLIC_ENABLE_3D="true"

NEXT_PUBLIC_3D_QUALITY="auto"

NEXT_PUBLIC_ENABLE_PARTICLES="true"

NEXT_PUBLIC_ENABLE_POSTPROCESSING="true"


