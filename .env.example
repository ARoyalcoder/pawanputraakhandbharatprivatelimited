# =========================================================
# SPLINE 3D
# =========================================================

NEXT_PUBLIC_SPLINE_HERO_URL="https://prod.spline.design/your-hero-scene/scene.splinecode"

NEXT_PUBLIC_SPLINE_SECURE_URL="https://prod.spline.design/your-secure-scene/scene.splinecode"

NEXT_PUBLIC_SPLINE_CONNECT_URL="https://prod.spline.design/your-connect-scene/scene.splinecode"

